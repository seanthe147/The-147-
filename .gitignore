# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native - anchor to project root so /credentials/android/ is not affected
/ios/
/android/
*.orig.*

# Signing files - ignored globally but un-ignored for specific committed credential files
*.jks
!credentials/android/keystore.jks
*.p8
!ios-creds/*.p8
*.p12
!ios-creds/*.p12
*.key
*.mobileprovision
!ios-creds/*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env

# Replit chat attachments (may contain sensitive files shared in chat)
attached_assets/
