# Copy this file to .env.local and fill in the values for local development.
# Do NOT commit .env.local — it is gitignored.

# Full base URL of the API server (no trailing slash).
# For local/dev builds, use your Replit dev domain:
EXPO_PUBLIC_API_BASE_URL=https://<your-replit-dev-domain>/api

# For production builds this is set via EAS environment variables — see BUILD.md.
