{
  "name": "@workspace/the-147-kiosk",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_API_BASE_URL=https://$REPLIT_DEV_DOMAIN/api REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN npx expo start --localhost --port 19390",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "update:production": "EAS_SKIP_AUTO_FINGERPRINT=1 eas update --channel production --message",
    "build:ios": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform ios --profile production --non-interactive",
    "build:android": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile production --non-interactive",
    "build:all": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform all --profile production --non-interactive",
    "submit:ios": "EAS_SKIP_AUTO_FINGERPRINT=1 eas submit --platform ios --latest"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/vector-icons": "^15.0.3",
    "@expo/cli": "54.0.23",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.21",
    "@types/react": "~19.1.10",
    "expo": "~54.0.27",
    "expo-blur": "~15.0.8",
    "expo-updates": "~29.0.17",
    "expo-constants": "~18.0.11",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-router": "~6.0.17",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "typescript": "~5.9.2"
  }
}
