{
  "$schema": "https://json.eas.dev/eas.schema.json",
  "_secrets": {
    "GOOGLE_SERVICES_JSON": "EAS file secret — upload with: eas secret:create --scope project --name GOOGLE_SERVICES_JSON --type file --value ./google-services.json",
    "GOOGLE_SERVICES_INFO_PLIST": "EAS file secret — upload with: eas secret:create --scope project --name GOOGLE_SERVICES_INFO_PLIST --type file --value ./GoogleService-Info.plist"
  },
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": false,
      "channel": "production",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6760673771",
        "appleTeamId": "94LW5H4828"
      }
    }
  }
}
