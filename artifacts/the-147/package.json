{
  "name": "@workspace/the-147",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eas-build-pre-install": "node scripts/prepare-android-firebase.js",
    "build:android": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile production --non-interactive",
    "build:android:preview": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile preview --non-interactive",
    "update:production": "EAS_SKIP_AUTO_FINGERPRINT=1 eas update --channel production --message",
    "update:preview": "EAS_SKIP_AUTO_FINGERPRINT=1 eas update --channel preview --message",
    "version:bump": "node scripts/bump-version.js",
    "test:version-bump": "node --test scripts/bump-version.test.js",
    "test:google-pay-errors": "node --experimental-strip-types --test lib/google-pay-errors.test.ts",
    "test:google-pay-branding": "node --experimental-strip-types --test lib/google-pay-branding.test.ts components/squarePaymentSheetHtml.test.ts components/squareCardFieldHtml.test.ts",
    "test:apple-pay-branding": "node --experimental-strip-types --test components/squarePaymentSheetHtml.test.ts components/squareCardFieldHtml.test.ts",
    "test:menu-grouping": "node --experimental-strip-types --test lib/menu-grouping.test.ts",
    "test:order-release-check": "node --experimental-strip-types --test lib/order-release-check.test.ts",
    "test:appearance": "node --experimental-strip-types --test lib/appearance.test.ts components/squarePaymentSheetHtml.test.ts",
    "prebuild:check": "node scripts/prebuild-check.js",
    "test:android-firebase": "node --test scripts/prepare-android-firebase.test.js",
    "test:build-toolchain": "node --test scripts/check-build-toolchain.test.js",
    "check-expo-config": "expo config --type introspect",
    "check-expo-deps": "expo install --check"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/cli": "57.0.27",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native/metro-config": "0.86.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.90.21",
    "@types/node": "catalog:",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "@workspace/db": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "~57.0.13",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-device": "^57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "patch-package": "^8.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "~13.16.1",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "expo-navigation-bar": "~57.0.3",
    "expo-updates": "~57.0.25",
    "react-native-square-in-app-payments": "^2.0.1"
  }
}
