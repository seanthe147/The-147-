entrypoint = "README.md"
modules = ["nodejs-22", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[env]
PORT = "5000"

[agent]
stack = "EXPO"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run expo:dev"
waitForPort = 8081
ensurePreviewReachable = "/status"

[userenv]

[userenv.shared]
SQUARE_ENVIRONMENT = "production"
RESEND_FROM_EMAIL = "onboarding@resend.dev"
RESEND_FROM_NAME = "The 147"
EXPO_ASC_KEY_ID = "PRH75PPG5Z"
EXPO_ASC_ISSUER_ID = "7cdddb46-b377-45c0-9cbe-e07c358d3cc5"
EXPO_APPLE_TEAM_ID = "94LW5H4828"
EXPO_APPLE_TEAM_TYPE = "COMPANY_OR_ORGANIZATION"
EXPO_ASC_API_KEY_PATH = "/tmp/AuthKey_PRH75PPG5Z.p8"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
