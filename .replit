modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Kiosk"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "validate-kiosk-env"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-api-server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-expo-config"

[[workflows.workflow]]
name = "Start Kiosk"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN pnpm --filter @workspace/the-147-kiosk run dev"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "validate-kiosk-env"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_PUBLIC_API_BASE_URL=https://ci.example.com/api pnpm --filter @workspace/scripts run validate-kiosk-env"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-api-server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-expo-config"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/the-147 run check-expo-config"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3001

[[ports]]
localPort = 19289
externalPort = 4200

[[ports]]
localPort = 19290
externalPort = 5173

[[ports]]
localPort = 19390
externalPort = 3002

[[ports]]
localPort = 19391
externalPort = 5000

[[ports]]
localPort = 23636
externalPort = 3003

[userenv]

[userenv.shared]
SQUARE_ENVIRONMENT = "production"

[nix]
channel = "stable-25_05"
