{
  "cli": {
    "version": ">= 16.0.0",
    "promptToConfigurePushNotifications": false,
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "the147bradford.replit.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "local"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "the147bradford.replit.app"
      }
    },
    "production-android": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "the147bradford.replit.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6760673771",
        "ascApiKeyIssuerId": "7cdddb46-b377-45c0-9cbe-e07c358d3cc5",
        "ascApiKeyId": "URDY56X3U2",
        "ascApiKeyPath": "ios-creds/AuthKey_URDY56X3U2.p8"
      }
    }
  }
}
